GEMINI_API_KEY=sua_chave_aqui
MAX_FILE_SIZE_MB=10
# Opcional: modelo do Gemini (padrão: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
